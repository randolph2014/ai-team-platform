{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "solution-plan.json",
  "title": "Solution Plan Artifact",
  "description": "方案定稿产物，描述决策、影响范围、配置策略、风险、回滚和验证策略",
  "type": "object",
  "required": [
    "status",
    "summary",
    "decisions",
    "alternatives_considered",
    "impact_scope",
    "configuration_strategy",
    "risks",
    "rollback_strategy",
    "verification_strategy",
    "evidence",
    "next_stage_contract"
  ],
  "properties": {
    "status": {"type": "string", "enum": ["completed", "failed", "partial"]},
    "summary": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "decision"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1},
          "rationale": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "alternatives_considered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option", "reason_rejected"],
        "properties": {
          "option": {"type": "string", "minLength": 1},
          "reason_rejected": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "impact_scope": {"type": "array", "items": {"type": "string"}},
    "configuration_strategy": {"type": "object"},
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "impact"],
        "properties": {
          "risk": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "mitigation": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "rollback_strategy": {"type": "object"},
    "verification_strategy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "expected"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "finding"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "supports": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "next_stage_contract": {"type": "object"}
  },
  "additionalProperties": false
}
