{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review-report.json",
  "title": "Review Report Artifact",
  "description": "结构化代码审查报告产物，verdict 和 blocking_findings 驱动回流",
  "type": "object",
  "required": ["status", "summary", "verdict", "blocking_findings"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "partial"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["Approve", "Request Changes"]
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file_path", "description"],
        "properties": {
          "severity": {"type": "string", "enum": ["Critical", "Warning"]},
          "file_path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1},
          "fix_suggestion": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file_path", "description"],
        "properties": {
          "severity": {"type": "string", "enum": ["Critical", "Warning", "Suggestion"]},
          "file_path": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "description": {"type": "string"},
          "fix_suggestion": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "finding"],
        "properties": {
          "source": {"type": "string"},
          "finding": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "impact"],
        "properties": {
          "risk": {"type": "string"},
          "impact": {"type": "string"},
          "mitigation": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
