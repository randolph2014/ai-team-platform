{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review-report.json",
  "title": "Review Report Artifact",
  "description": "结构化代码审查报告产物，verdict 和 blocking_findings 驱动回流",
  "type": "object",
  "required": ["status", "summary", "verdict", "review_dimensions", "blocking_findings", "findings", "evidence", "risks", "traceability"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "partial"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["Approve", "Request Changes"]
    },
    "review_dimensions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["dimension", "status", "evidence"],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": ["spec", "regression", "architecture", "debt", "test"]
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "warning", "blocked"]
          },
          "evidence": {"type": "string", "minLength": 1},
          "finding_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file_path", "description"],
        "properties": {
          "severity": {"type": "string", "enum": ["Critical", "Warning"]},
          "file_path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1},
          "fix_suggestion": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file_path", "description"],
        "properties": {
          "severity": {"type": "string", "enum": ["Critical", "Warning", "Suggestion"]},
          "file_path": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "description": {"type": "string"},
          "fix_suggestion": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "finding"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "impact"],
        "properties": {
          "risk": {"type": "string"},
          "impact": {"type": "string"},
          "mitigation": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "acceptance_id", "status", "evidence_refs", "files", "tests"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "acceptance_id": {"type": "string", "pattern": "^AC-"},
          "status": {"type": "string", "enum": ["verified", "passed", "failed", "partial", "blocked"]},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "harness_checks": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
