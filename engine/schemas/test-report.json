{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "test-report.json",
  "title": "Test Report Artifact",
  "description": "结构化 QA 测试报告产物，包含命令、退出码、耗时和汇总",
  "type": "object",
  "required": ["status", "summary", "commands", "results", "acceptance_coverage", "evidence", "traceability"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "partial"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": ["integer", "null"]},
          "duration": {"type": ["number", "null"], "minimum": 0},
          "result": {"type": "string", "enum": ["passed", "failed", "blocked", "skipped", "error", "success"]},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_name", "status"],
        "properties": {
          "test_name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["passed", "failed", "skipped", "error", "blocked"]},
          "duration": {"type": ["number", "null"], "minimum": 0},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "acceptance_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["acceptance_id", "status", "covered_by"],
        "properties": {
          "acceptance_id": {"type": "string", "pattern": "^AC-"},
          "covered_by": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["passed", "failed", "skipped", "blocked"]}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "finding"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "supports": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "acceptance_id", "status", "evidence_refs", "files", "tests"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "acceptance_id": {"type": "string", "pattern": "^AC-"},
          "status": {"type": "string", "enum": ["verified", "passed", "failed", "partial", "blocked"]},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "harness_checks": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
