{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "implementation-report.json",
  "title": "Implementation Report Artifact",
  "description": "结构化实施报告产物，必须绑定验收点、文件、测试和证据链",
  "type": "object",
  "required": [
    "status",
    "summary",
    "changed_files",
    "tests_run",
    "acceptance_coverage",
    "evidence",
    "risks",
    "traceability"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "partial"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "duration", "result"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "duration": {"type": "number", "minimum": 0},
          "result": {"type": "string", "enum": ["passed", "failed", "skipped", "blocked"]},
          "message": {"type": "string"},
          "output_excerpt": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "acceptance_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["acceptance_id", "status", "evidence"],
        "properties": {
          "acceptance_id": {"type": "string", "pattern": "^AC-"},
          "status": {"type": "string", "enum": ["passed", "failed", "partial", "blocked"]},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "finding"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "supports": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "impact"],
        "properties": {
          "risk": {"type": "string"},
          "impact": {"type": "string"},
          "mitigation": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "acceptance_id", "status", "evidence_refs", "files", "tests"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "acceptance_id": {"type": "string", "pattern": "^AC-"},
          "status": {"type": "string", "enum": ["verified", "passed", "failed", "partial", "blocked"]},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "harness_checks": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "units": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
